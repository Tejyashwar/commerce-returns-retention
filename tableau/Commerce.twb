  <dashboards>
    <dashboard name="01 Sales and Returns">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#ffffff" fontsize="14">SALES &amp; RETURNS | Recorded lines (CU); 147 orders lack amounts | Boundary months partial</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight="700" maxwidth="1100" minheight="700" minwidth="1100" sizing-mode="fixed" />
      <zones>
        <zone h="11500" id="1" type-v2="title" w="100000" x="0" y="0">
          <zone-style>
            <format attr="background-color" value="#122d3f" />
            <format attr="padding" value="16" />
          </zone-style>
        </zone>
        <zone h="12500" id="2" name="Gross value (CU)" w="23000" x="1500" y="13500">
          <zone-style>
            <format attr="background-color" value="#ffffff" />
            <format attr="border-color" value="#dce6eb" />
            <format attr="border-style" value="solid" />
            <format attr="border-width" value="1" />
            <format attr="margin" value="4" />
          </zone-style>
        </zone>
        <zone h="12500" id="3" name="Retained value (CU)" w="23000" x="26000" y="13500">
          <zone-style>
            <format attr="background-color" value="#ffffff" />
            <format attr="border-color" value="#dce6eb" />
            <format attr="border-style" value="solid" />
            <format attr="border-width" value="1" />
            <format attr="margin" value="4" />
          </zone-style>
