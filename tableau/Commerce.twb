  <datasources>
    <datasource caption="Overview" inline="true" name="textscan.overview" version="18.1">
      <connection class="textscan" directory="Data" filename="overview.csv" password="" server="">
        <relation name="overview#csv" table="[overview#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="date" name="period_start" ordinal="0" />
            <column datatype="date" name="period_end" ordinal="1" />
            <column datatype="integer" name="orders" ordinal="2" />
            <column datatype="integer" name="purchasing_customers" ordinal="3" />
            <column datatype="real" name="gross_value" ordinal="4" />
            <column datatype="real" name="returned_value" ordinal="5" />
            <column datatype="real" name="retained_value" ordinal="6" />
            <column datatype="integer" name="returned_orders" ordinal="7" />
            <column datatype="real" name="order_return_rate" ordinal="8" />
            <column datatype="real" name="value_return_rate" ordinal="9" />
            <column datatype="integer" name="orders_with_lines" ordinal="10" />
            <column datatype="integer" name="orders_missing_lines" ordinal="11" />
            <column datatype="real" name="gross_aov_priced_orders" ordinal="12" />
            <column datatype="integer" name="chronology_issues" ordinal="13" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column datatype="date" name="[period_start]" caption="Period Start" role="dimension" type="ordinal" />
      <column datatype="date" name="[period_end]" caption="Period End" role="dimension" type="ordinal" />
      <column datatype="integer" name="[orders]" caption="Orders" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="integer" name="[purchasing_customers]" caption="Purchasing Customers" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="real" name="[gross_value]" caption="Gross Value" role="measure" type="quantitative" default-format="n#,##0.00" />
      <column datatype="real" name="[returned_value]" caption="Returned Value" role="measure" type="quantitative" default-format="n#,##0.00" />
      <column datatype="real" name="[retained_value]" caption="Retained Value" role="measure" type="quantitative" default-format="n#,##0.00" />
      <column datatype="integer" name="[returned_orders]" caption="Returned Orders" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="real" name="[order_return_rate]" caption="Order Return Rate" role="measure" type="quantitative" default-format="p0.0%" />
      <column datatype="real" name="[value_return_rate]" caption="Value Return Rate" role="measure" type="quantitative" default-format="p0.0%" />
      <column datatype="integer" name="[orders_with_lines]" caption="Orders With Lines" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="integer" name="[orders_missing_lines]" caption="Orders Missing Lines" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="real" name="[gross_aov_priced_orders]" caption="Gross Aov Priced Orders" role="measure" type="quantitative" default-format="n#,##0.00" />
      <column datatype="integer" name="[chronology_issues]" caption="Chronology Issues" role="measure" type="quantitative" default-format="n#,##0" />
    </datasource>
